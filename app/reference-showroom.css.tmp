.referenceShowroomRoot{min-height:100vh;display:flex;align-items:flex-start;justify-content:center;overflow:auto;background:#c9ab8a}.referenceShowroomCanvas{position:relative;flex:0 0 auto;width:min(100vw,calc(100vh * 1.3186119874));aspect-ratio:836/634;background-image:url("/showroom-reference.webp");background-size:100% 100%;background-repeat:no-repeat;background-position:center top;box-shadow:0 0 42px rgba(73,45,25,.18)}.referenceTab{position:absolute;z-index:7;border:1px solid #ded4c8;border-radius:9px;background:rgba(237,232,225,.98);color:#5d5b58;font-family:Arial,"Microsoft JhengHei",sans-serif;font-weight:800;font-size:clamp(10px,.9vw,14px);cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 1px rgba(255,255,255,.8);padding:0}.referenceTab.active{background:linear-gradient(180deg,#9b663c,#80502c);border-color:#b58252;color:#fff8ee;box-shadow:0 4px 10px rgba(91,54,30,.25),inset 0 1px rgba(255,255,255,.18)}.referenceCardHotspot{position:absolute;z-index:6;display:block;border-radius:15px;background:transparent;cursor:pointer;text-decoration:none}.referenceCardHotspot:hover{box-shadow:inset 0 0 0 2px rgba(151,98,56,.22)}.referenceCardHotspot:focus-visible{outline:3px solid rgba(117,75,42,.65);outline-offset:-3px}.referenceStatus{position:absolute;z-index:10;left:38%;top:46%;width:30%;padding:12px 14px;border-radius:12px;background:rgba(255,250,244,.94);color:#6b5542;text-align:center;font-weight:700;box-shadow:0 8px 24px rgba(70,44,25,.14)}.referenceStatus.error{color:#a52f2f;background:rgba(255,241,238,.96)}@media(max-width:700px){.referenceShowroomRoot{display:none}}